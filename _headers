# En-têtes de sécurité envoyés par Netlify pour toutes les pages.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Content-Security-Policy: frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'

# Images : mises en cache 7 jours (chargement plus rapide sur mobile)
/assets/*
  Cache-Control: public, max-age=604800

# Scripts et styles : revalidés toutes les heures (les mises à jour arrivent vite)
/css/*
  Cache-Control: public, max-age=3600, must-revalidate
/js/*
  Cache-Control: public, max-age=3600, must-revalidate

# Le service worker doit toujours être relu pour que les mises à jour soient prises en compte
/sw.js
  Cache-Control: no-cache

# Espaces privés : jamais indexés par les moteurs de recherche
/admin/*
  X-Robots-Tag: noindex, nofollow
/dashboard/*
  X-Robots-Tag: noindex, nofollow
/auth/*
  X-Robots-Tag: noindex, nofollow

# Vérification du lien site ↔ application Android (Google Play)
/.well-known/assetlinks.json
  Content-Type: application/json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600
