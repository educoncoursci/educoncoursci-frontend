# En-têtes de sécurité envoyés par Cloudflare Pages pour toutes les pages.
# La politique « Content-Security-Policy » limite les sites dont le navigateur accepte
# les scripts, les connexions et les cadres : un script malveillant venu d'ailleurs est bloqué.
# Si vous ajoutez un nouveau service externe (autre outil de statistiques, widget…),
# ajoutez son adresse ici, sinon le navigateur le bloquera.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' data: blob:; connect-src 'self' https://educoncoursci-backend.onrender.com https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com https://cloudflareinsights.com https://static.cloudflareinsights.com; frame-src https://maps.google.com https://www.google.com; worker-src 'self'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'

# Images : mises en cache 7 jours (chargement plus rapide sur mobile)
/assets/*
  Cache-Control: public, max-age=604800

# Scripts et styles : revalidés toutes les heures (les mises à jour arrivent vite)
/css/*
  Cache-Control: public, max-age=3600, must-revalidate
/js/*
  Cache-Control: public, max-age=3600, must-revalidate

# Le service worker doit toujours être relu pour que les mises à jour soient prises en compte
/sw.js
  Cache-Control: no-cache

# Espaces privés : jamais indexés par les moteurs de recherche
/admin/*
  X-Robots-Tag: noindex, nofollow
/dashboard/*
  X-Robots-Tag: noindex, nofollow
/auth/*
  X-Robots-Tag: noindex, nofollow

# Vérification du lien site ↔ application Android (Google Play)
/.well-known/assetlinks.json
  Content-Type: application/json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600
